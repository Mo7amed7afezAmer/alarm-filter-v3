# G-T16 reverse proxy: the only service publishing ports (NFR-26).
# D-06: self-signed certificates from Caddy's internal CA; NOC devices trust the root CA once
# (RUNBOOK "TLS trust"). HTTP is redirected to HTTPS automatically.
{
	order rate_limit before reverse_proxy
}

{$SITE_ADDRESS:localhost} {
	tls internal

	# D-08: 10 login attempts per minute per client IP; the 11th gets 429.
	rate_limit {
		zone login {
			match {
				method POST
				path /api/auth/callback/credentials
			}
			key    {remote_host}
			events 10
			window 1m
		}
	}

	reverse_proxy web:3000
}
