# PostgreSQL (docker-compose.yml: db, migrate)
POSTGRES_USER=alarms
POSTGRES_PASSWORD=change-me
POSTGRES_DB=alarms

# Prisma connection string used by packages/db
DATABASE_URL=postgresql://alarms:change-me@127.0.0.1:5432/alarms

# Initial ADMIN user, created once by the seed (FR-29)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Integration tests: dedicated database alarms_test (NFR-41)
TEST_DATABASE_URL=postgresql://alarms:change-me@127.0.0.1:5432/alarms_test
