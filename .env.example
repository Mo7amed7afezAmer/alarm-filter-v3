# PostgreSQL (docker-compose.yml: db, migrate)
POSTGRES_USER=alarms
POSTGRES_PASSWORD=change-me
POSTGRES_DB=alarms

# Prisma connection string used by packages/db
DATABASE_URL=postgresql://alarms:change-me@127.0.0.1:5432/alarms

# Initial ADMIN user, created once by the seed (FR-29)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Integration tests: dedicated database alarms_test (NFR-41)
TEST_DATABASE_URL=postgresql://alarms:change-me@127.0.0.1:5432/alarms_test

# Gmail OAuth files (NFR-21): Desktop-app client and the token written by `pnpm gmail:auth`.
# Both are gitignored; Docker mounts them read-only.
GOOGLE_CREDENTIALS_PATH=./secrets/credentials.json
GOOGLE_TOKEN_PATH=./secrets/token.json

# Ingestion (FR-03, FR-05)
INITIAL_BACKFILL_HOURS=24
MAX_MESSAGES_PER_RUN=200
GMAIL_QUERY=

# Worker (FR-01, FR-07, FR-08, FR-69)
GMAIL_LABELS=
OFFICE_LABEL_PARENTS=DN,DS
ALARM_TZ=Africa/Cairo
WORKER_CRON=* * * * *
WORKER_HEALTH_PORT=4000
HEALTH_STALE_AFTER_SEC=300

# Web (FR-25): NextAuth needs a long random secret; the web app refuses to start without it.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
